{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TetherChat",
  "version": "1.0.0",
  "identifier": "ru.tetherchat.desktop",
  "build": {
    "beforeDevCommand": "VITE_API_URL=http://localhost:4000 VITE_WS_URL=http://localhost:4000 VITE_DESKTOP=1 npm run dev -w @tetherchat/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TetherChat",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    },
    "shortDescription": "TetherChat messenger",
    "longDescription": "Desktop client for TetherChat — team and friends messenger."
  }
}
