# ---------------------------------------------------------------------------
# TetherChat environment. Copy to .env and adjust before running.
# `docker compose up` reads this file for every service.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- API ---------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# Postgres. Inside docker compose the host is `postgres`.
POSTGRES_USER=tetherchat
POSTGRES_PASSWORD=tetherchat
POSTGRES_DB=tetherchat
DATABASE_URL=postgresql://tetherchat:tetherchat@localhost:5432/tetherchat?schema=public

# Separate database used by `npm test` in the API workspace.
TEST_DATABASE_URL=postgresql://tetherchat:tetherchat@localhost:5432/tetherchat_test?schema=public

# Redis. Inside docker compose the host is `redis`.
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Public origins. In production: https://tetherchat.ru for both.
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:4000
# COOKIE_DOMAIN=.tetherchat.ru
COOKIE_SECURE=false

# --- File storage ------------------------------------------------------------
# local  -> files written to STORAGE_LOCAL_DIR and served from /files
# s3     -> MinIO or any S3-compatible bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tetherchat
S3_ACCESS_KEY=tetherchat
S3_SECRET_KEY=tetherchat-secret
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://tetherchat.ru/files

# --- Background jobs ---------------------------------------------------------
ENABLE_WORKERS=true
ENABLE_LINK_PREVIEWS=true

# --- Web push (optional) -----------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tetherchat.ru

# Firebase Cloud Messaging — Android notifications when the app process is killed.
# Create a Firebase project, add Android app package ru.tetherchat.app,
# then paste the service account as a single-line JSON or base64 (preferred,
# because .env cannot hold raw newlines from the private key).
# FCM_SERVICE_ACCOUNT_JSON=
# Public Android client ids from google-services.json (safe to expose to the APK).
FCM_PROJECT_ID=tetherchat-a99ee
FCM_APPLICATION_ID=1:255228613217:android:90872b6c01ac7209611020
FCM_API_KEY=AIzaSyBPlRNE-25fxg-_4lp_bClrWXKJQhBNTas
FCM_SENDER_ID=255228613217

# --- Mail --------------------------------------------------------------------
# Local dev (after `docker compose up -d mailpit`): inbox at http://localhost:8025
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=TetherChat <no-reply@localhost>

# Production — Gmail (простой вариант, обычный ящик tetherchat@gmail.com):
# 1. Включите двухфакторку в Google-аккаунте
# 2. Создайте пароль приложения: https://myaccount.google.com/apppasswords
# 3. MAIL_FROM должен совпадать с адресом ящика (Gmail не шлёт от чужого From)
# SMTP_URL=smtps://tetherchat@gmail.com:APP_PASSWORD@smtp.gmail.com:465
# MAIL_FROM=TetherChat <tetherchat@gmail.com>
#
# Проверка: npm run mail:test -w @tetherchat/api -- your@email.com
#
# Другие варианты:
# Brevo: SMTP_URL=smtps://LOGIN:SMTP_KEY@smtp-relay.brevo.com:465
# Resend API (если SMTP_URL пуст): RESEND_API_KEY=re_...

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
MESSAGE_RATE_PER_10S=30

# --- Built-in «Нейросеть» DM (optional, free) --------------------------------
# Create a free key at https://console.groq.com/keys (no credit card).
# Without a key the chat still appears; the bot explains that it is not connected.
GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# --- Web app (build time) ----------------------------------------------------
# Leave empty for same-origin requests: the vite dev server proxies /api and
# /socket.io to the API, and nginx does the same in production. Set an absolute
# URL only when the API lives on another host.
VITE_API_URL=
VITE_WS_URL=
VITE_VAPID_PUBLIC_KEY=
VITE_LIVEKIT_URL=

# --- LiveKit (voice calls) ---------------------------------------------------
# Generate with: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Internal URL for the API container.
LIVEKIT_URL=ws://livekit:7880
# Public WSS URL for web/Android clients (proxied by nginx at /livekit/).
PUBLIC_LIVEKIT_URL=wss://tetherchat.ru/livekit
# Public IP of the VPS — required for WebRTC when use_external_ip is true.
LIVEKIT_NODE_IP=

# --- Enigma VPN bot (Happ + Marzban + YooMoney) ---------------------------
# Built-in DM with @tethervpn — plans, trial, payment, subscription link.
VPN_BRAND_NAME=Enigma VPN
VPN_SUBSCRIPTION_PREFIX=https://tetherchat.ru/api/vpn/s
MARZBAN_URL=http://host.docker.internal:8000
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=
# Set to false when Marzban is reachable from the API container.
MARZBAN_MOCK=true
YOOMONEY_WALLET=
YOOMONEY_NOTIFICATION_SECRET=
VPN_TRIAL_ENABLED=true
VPN_TRIAL_DURATION_DAYS=1
VPN_TRIAL_TRAFFIC_GB=5
VPN_TRIAL_DEVICE_LIMIT=1
VPN_NODE_ID=nl-1
