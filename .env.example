# ---------------------------------------------------------------------------
# TetherChat environment. Copy to .env and adjust before running.
# `docker compose up` reads this file for every service.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- API ---------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# Postgres. Inside docker compose the host is `postgres`.
POSTGRES_USER=tetherchat
POSTGRES_PASSWORD=tetherchat
POSTGRES_DB=tetherchat
DATABASE_URL=postgresql://tetherchat:tetherchat@localhost:5432/tetherchat?schema=public

# Redis. Inside docker compose the host is `redis`.
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Public origins. In production: https://tetherchat.ru for both.
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:4000
# COOKIE_DOMAIN=.tetherchat.ru
COOKIE_SECURE=false

# --- File storage ------------------------------------------------------------
# local  -> files written to STORAGE_LOCAL_DIR and served from /files
# s3     -> MinIO or any S3-compatible bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tetherchat
S3_ACCESS_KEY=tetherchat
S3_SECRET_KEY=tetherchat-secret
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://tetherchat.ru/files

# --- Background jobs ---------------------------------------------------------
ENABLE_WORKERS=true
ENABLE_LINK_PREVIEWS=true

# --- Web push (optional) -----------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tetherchat.ru

# --- Mail (optional; logged to stdout when empty) ----------------------------
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=TetherChat <no-reply@tetherchat.ru>

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
MESSAGE_RATE_PER_10S=30

# --- Web app (build time) ----------------------------------------------------
# Leave empty to use same-origin /api and /socket.io (what nginx serves in prod).
VITE_API_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
VITE_VAPID_PUBLIC_KEY=
